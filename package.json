{
  "name": "stablecoin-payments-reference",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable reference implementation of a stablecoin payment orchestration layer.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/ui",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "ledger:seed": "tsx scripts/ledger-seed.ts",
    "experiment:crash": "tsx scripts/experiments/crash.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@payments/chain": "workspace:*",
    "@payments/db": "workspace:*",
    "@payments/domain": "workspace:*",
    "@payments/ledger": "workspace:*",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "viem": "2.56.7",
    "vitest": "5.0.1"
  }
}
