{
  // Typechecks the whole workspace in one pass, including files that belong to no
  // package: root-level scripts and config files. Each package keeps its own
  // tsconfig.json for editors, the linter and, later, its build.
  "extends": "./tsconfig.base.json",
  // `*.mts` picks up vitest.db.config.mts: Vite loads config files as ES modules, and the
  // workspace is CommonJS, so the explicit extension is what keeps that one file honest.
  "include": ["apps", "packages", "scripts", "tests", "*.ts", "*.mts"],
  // `apps/ui` is not here: a browser app needs DOM libs and JSX settings that would
  // pollute every Node package. It typechecks itself, with its own tsconfig.
  "exclude": ["**/node_modules", "**/dist", "apps/ui"]
}
