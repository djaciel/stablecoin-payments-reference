# You do NOT need this file to run the demo. `docker compose up` passes every value the
# containers need, and nothing here is required for it.
#
# Copy it to .env only if you want to run a service straight on your machine, or if one of
# the ports below is already taken on your host. The .env file stays out of version control.

# Port Postgres is published on, for your database client. Compose reads this file, so
# setting it here is enough: use it when something else already owns 5432.
POSTGRES_PORT=5432

# Where a service started on your machine finds Postgres. Inside compose the host is
# `postgres`; from your machine it is `localhost` and the port above.
DATABASE_URL=postgres://payments:payments@localhost:5432/payments

# Port the API listens on when you start it yourself. Inside compose it is always 3000,
# and the signer is always 3001 (it is not published: only the other containers reach it).
PORT=3000

# Where the signer keeps the company seed, and where the api looks for the signer. Both
# default to what compose uses, so you only need these to run a service on your machine:
# KEYS_DIR then has to be a directory you can write to, and SIGNER_URL the localhost
# address of a signer you started yourself.
KEYS_DIR=./.keys/company
SIGNER_URL=http://localhost:3001

# Ports Temporal and its web ui are published on. Same reason as POSTGRES_PORT: set these
# only if something on your machine already owns 7233 or 8080.
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# Where a service started on your machine finds Temporal. Inside compose the host is
# `temporal`; from your machine it is `localhost` and the port above. `pnpm demo:workflow`
# uses these defaults without needing this file at all.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=payments
